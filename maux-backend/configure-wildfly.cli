# ============================================================
# Script CLI para configurar WildFly
# Ejecutar desde $JBOSS_HOME/bin:
#   ./jboss-cli.sh --file=/ruta/a/configure-wildfly.cli
# ============================================================

# 1. Agregar módulo JDBC PostgreSQL
module add --name=org.postgresql \
    --resources=/tmp/postgresql-42.7.4.jar \
    --dependencies=javax.api,javax.transaction.api

# 2. Registrar driver PostgreSQL
/subsystem=datasources/jdbc-driver=postgresql:add( \
    driver-name="postgresql", \
    driver-module-name="org.postgresql", \
    driver-class-name=org.postgresql.Driver \
)

# 3. Crear datasource JTA
/subsystem=datasources/data-source=MariaAuxiliadoraDS:add( \
    jndi-name="java:/MariaAuxiliadoraDS", \
    driver-name="postgresql", \
    connection-url="jdbc:postgresql://localhost:5432/MARIA_AUXILIADORA", \
    user-name="app_web", \
    password="jImAjNFUCqB0L2KU", \
    jta="true", \
    min-pool-size="5", \
    max-pool-size="20" \
)

# 4. Habilitar el datasource
/subsystem=datasources/data-source=MariaAuxiliadoraDS:enable

# 5. Recargar configuración
reload
